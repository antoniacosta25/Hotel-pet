<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cadastro do Pet - Hotel Pet</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>🐾 Hotel Pet</h1>

        <nav>
            <a href="inicio.html">Início</a>
            <a href="servicos.html">Serviços</a>
            <a href="reservas.html">Reservas</a>
        </nav>
    </header>

    <main class="cadastro-pet-container">

        <div class="cadastro-pet-box">

            <h2>Cadastre seu Pet 🐶🐱</h2>

            <p>
                Informe os dados do seu melhor amigo.
            </p>

            <form>

                <label for="nome">Nome do pet</label>
                <input
                    type="text"
                    id="nome"
                    name="nome"
                    placeholder="Digite o nome do pet"
                    required
                >

                <label for="tipo">Tipo de animal</label>
                <select id="tipo" name="tipo" required>
                    <option value="">Selecione</option>
                    <option value="cachorro">Cachorro</option>
                    <option value="gato">Gato</option>
                    <option value="outro">Outro</option>
                </select>

                <label for="raca">Raça</label>
                <input
                    type="text"
                    id="raca"
                    name="raca"
                    placeholder="Digite a raça"
                >

                <label for="idade">Idade</label>
                <input
                    type="number"
                    id="idade"
                    name="idade"
                    placeholder="Digite a idade"
                    min="0"
                >

                <label for="sexo">Sexo</label>
                <select id="sexo" name="sexo">
                    <option value="">Selecione</option>
                    <option value="macho">Macho</option>
                    <option value="femea">Fêmea</option>
                </select>

                <label for="observacoes">Observações</label>
                <textarea
                    id="observacoes"
                    name="observacoes"
                    rows="4"
                    placeholder="Informe cuidados especiais, alimentação ou outras informações"
                ></textarea>

                <button type="submit">
                    Cadastrar Pet
                </button>

            </form>

            <a class="voltar" href="inicio.html">
                ← Voltar para o início
            </a>

        </div>

    </main>

    <footer>
        <p>© 2026 Hotel Pet - Cuidando com carinho do seu melhor amigo 🐾</p>
    </footer>

</body>
</html>
